{
  "name": "qa-playwright-orangehrm",
  "version": "1.0.0",
  "description": "Automated testing suite for OrangeHRM using Playwright + TypeScript with Page Object Model",
  "author": "Khoirul Gunawan",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:smoke": "playwright test tests/smoke/",
    "test:auth": "playwright test tests/auth/",
    "test:pim": "playwright test tests/pim/",
    "test:leave": "playwright test tests/leave/",
    "test:recruitment": "playwright test tests/recruitment/",
    "test:accessibility": "playwright test tests/accessibility/",
    "test:api": "playwright test tests/api/",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report:html": "playwright show-report",
    "report:allure": "allure serve allure-results",
    "report:allure:generate": "allure generate allure-results --clean -o allure-report",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
